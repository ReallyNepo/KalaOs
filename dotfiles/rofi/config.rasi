/* KalaOS Rofi Config - Theme loaded from ~/.config/rofi/kalaos-theme.rasi (generated by theming module) */

@theme "kalaos-theme"

configuration {
    show-icons: true;
    icon-theme: "kalaos-icons";
    font: "SF Pro Display 11";
    drun-display-format: "{name} [{generic}]";
    terminal: "ghostty";
    ssh-client: "ghostty -e ssh";
    run-command: "{cmd} &";
    run-shell-command: "{terminal} -e {cmd}";
    match-alg: "fzf";
    sort: true;
    sidebar-mode: false;
    window-width: 60;
    scrollbar: false;
    click-to-exit: true;
}